# URBANO AR - Configuración de Puertos
# Copia este archivo a .env y ajusta los puertos si es necesario
# El script setup.ps1 genera automáticamente este archivo

# Puerto MySQL (se mapea internamente al 3306)
# Si 3307 está ocupado, cambia a otro puerto
MYSQL_PORT=3307

# Puerto Backend (Node.js Express)
# Si 3000 está ocupado, cambia a otro puerto
BACKEND_PORT=3000

# Puerto Frontend (React Vite)
# Si 5173 está ocupado, cambia a otro puerto
FRONTEND_PORT=5173

# Puerto Probador (Flask Python)
# Este corre en local, no en Docker, pero se configura en el código
PROBADOR_PORT=5000
